# Sthiranet surveillance demo: Rust backend (surveillance-director) + React/TypeScript UI.
SHELL := /bin/bash
.PHONY: install build start dev test check api vectors stop clean distclean

install:            ## install UI dependencies
	cd demo/ui && npm ci

api:                ## regenerate the UI's TypeScript API types from the Rust OpenAPI spec
	cd demo/ui && npm run gen:api

build: api          ## build the UI and the server (release)
	cd demo/ui && npm run build
	cargo build --release -p surveillance-director

start: build        ## build everything, then serve on http://localhost:$${PORT:-3000}
	./target/release/surveillance-director

dev:                ## API on :3000 plus Vite with hot reload on :5173 (open :5173)
	cargo run -p surveillance-director & cd demo/ui && npm run dev

test:               ## Rust tests (incl. the 8-scene story) and the UI type-check
	cargo test --workspace
	cd demo/ui && npm run typecheck

check:              ## formatting and lints, as CI would run them
	cargo fmt --all --check
	cargo clippy --workspace --all-targets -- -D warnings
	cd demo/ui && npm run typecheck

vectors:            ## regenerate the cross-language test vectors with the independent Python implementation
	python3 -I test-vectors/generate.py > test-vectors/hashing-v1.json
	python3 -I test-vectors/generate.py surveillance > test-vectors/surveillance-v1.json

# Linux keeps only the first 15 characters of a process name, which is what `pkill -x` matches.
stop:               ## stop any running demo server (its demo state lives only in memory, so this clears it)
	-pkill -x surveillance-di && echo "surveillance-director stopped" || echo "no surveillance-director running"

clean: stop         ## stop the server and delete everything compiled or generated by builds and runs
	cargo clean
	rm -rf demo/ui/dist demo/ui/node_modules/.vite demo/ui/node_modules/.tmp demo/ui/openapi.json

distclean: clean    ## also remove the installed UI dependencies (run `make install` again afterwards)
	rm -rf demo/ui/node_modules
